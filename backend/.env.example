# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campus_booking?retryWrites=true&w=majority

# Frontend Origin (for CORS)
FRONTEND_URL=http://localhost:5173

# JWT Secret (generate a long random string)
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Institutional Email Domains (comma-separated)
INSTITUTION_EMAIL_DOMAINS=ug.cusat.ac.in,pg.cusat.ac.in

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="CUSAT Resource Booking <noreply@cusat.ac.in>"

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Password Reset
RESET_TOKEN_EXPIRY_MINUTES=30

# Campus Timezone
CAMPUS_TIMEZONE=Asia/Kolkata

# Dev mode: log OTP to console (NEVER set to true in production)
DEV_LOG_OTP=true
